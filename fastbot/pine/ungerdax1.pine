//@version=6
// ============================================================================================================
// UNGERDAX1 -- the DAX opening-range breakout from Andrea Unger's free 2016 webinar, as coded on ProRealCode
// (2016-06-10). Rebuilt from fastbot's UNGER2 test A (scripts/unger2_run.py, sys_A) for viewing in TradingView.
//
// RESULT (RESULT_UNGER2.md, OANDA DE30 5m, net of spreads):
//   before publication 2005 -> 2016-06-09 : +27.4 bp per trade, t 4.39 (375 trades)
//   after publication 2016-06-10 -> 2026-09: -0.8 bp per trade, t -0.28 (406 trades)  -> FAIL
//
// RULES (Europe/Berlin clock; built for a 5-minute chart, e.g. OANDA:DE30EUR; 15m-60m charts work as a coarser approximation):
//   range      : high (HH) and low (LL) of 08:00-09:00; delta = x * (HH - LL), x = 1
//   filter     : previous day's Dfactor = |close - open| / (high - low) over 08:00-22:00 must be < 0.5; no Fridays
//   entry      : a bar starting 09:00-09:55 CLOSES above HH + delta -> long at the next bar's open
//                (below LL - delta -> short); one position at a time; re-entry after a stop allowed until 10:00
//   stop       : HH for a long, LL for a short
//   exit       : flat at the close of the last bar before 22:00
//   costs      : commission 0.007% per side ~ half of the measured median DE30 spread (about 1.3-1.5 bp)
//
// I am not a financial adviser. This is a measurement, not a recommendation. TradingView's own data, session times
// and fill model differ from the fastbot harness, so the numbers will not match exactly.
// ============================================================================================================
strategy("UNGERDAX1 - DAX opening-range breakout (UNGER2 A)", overlay = true, initial_capital = 10000,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0,
     commission_type = strategy.commission.percent, commission_value = 0.007, slippage = 0,
     process_orders_on_close = false)

// ---------------- inputs
tz       = input.string("Europe/Berlin", "Time zone")
x        = input.float(1.0, "Range multiplier x", step = 0.1)
y        = input.float(0.5, "Max previous-day Dfactor y", step = 0.05)
useDf    = input.bool(true, "Use the Dfactor filter")
skipFri  = input.bool(true, "Skip Fridays")
stopMode = input.bool(false, "Variant: enter with stop orders at the level")
minCover = input.int(50, "Min minutes of 08:00-09:00 covered by bars (50 = 10 of 12 five-minute bars)", minval = 1)
startT   = input.time(timestamp("10 Jun 2016 00:00 +0200"), "Trade from (publication = 2016-06-10)")

// ---------------- clock
tfMin    = timeframe.in_seconds(timeframe.period) / 60
startMin = hour(time, tz) * 60 + minute(time, tz)
endMin   = startMin + tfMin
dom      = dayofmonth(time, tz)
newDay   = dom != nz(dom[1], dom)
inSess   = startMin >= 480 and startMin < 1320          // 08:00-21:55 bar starts
inRng    = startMin >= 480 and startMin < 540           // 08:00-08:55
inSig    = startMin >= 540 and startMin < 600           // 09:00-09:55 signal bars
lastBar  = startMin < 1320 and endMin >= 1320           // last bar before 22:00

// ---------------- day and range accumulators
var float dO = na
var float dH = na
var float dL = na
var float dC = na
var float pO = na
var float pH = na
var float pL = na
var float pC = na
var float HH = na
var float LL = na
var float rngCov = 0.0

if newDay
    if not na(dO)
        pO := dO
        pH := dH
        pL := dL
        pC := dC
    dO := na
    dH := na
    dL := na
    dC := na
    HH := na
    LL := na
    rngCov := 0.0

if inSess
    dO := na(dO) ? open : dO
    dH := na(dH) ? high : math.max(dH, high)
    dL := na(dL) ? low : math.min(dL, low)
    dC := close

if inRng
    HH := na(HH) ? high : math.max(HH, high)
    LL := na(LL) ? low : math.min(LL, low)
    rngCov += tfMin

// ---------------- conditions
delta = x * (HH - LL)
upLvl = HH + delta
dnLvl = LL - delta
dfac  = pH > pL ? math.abs(pC - pO) / (pH - pL) : na
isFri = dayofweek(time, tz) == dayofweek.friday
okDay = time >= startT and rngCov >= minCover and not na(pO) and HH > LL and (not skipFri or not isFri) and (not useDf or (not na(dfac) and dfac < y))
flat  = strategy.position_size == 0

// ---------------- entries
if not stopMode
    if okDay and inSig and flat
        if close > upLvl
            strategy.entry("L", strategy.long)
        else if close < dnLvl
            strategy.entry("S", strategy.short)
else
    // stop orders must be live DURING the 09:00-09:55 bars, so they are placed on the bar before each of them
    placeWin = startMin >= 540 - tfMin and startMin < 600 - tfMin
    if okDay and placeWin and flat
        strategy.entry("L", strategy.long, stop = upLvl, oca_name = "ORB", oca_type = strategy.oca.cancel)
        strategy.entry("S", strategy.short, stop = dnLvl, oca_name = "ORB", oca_type = strategy.oca.cancel)
    if not placeWin
        strategy.cancel("L")
        strategy.cancel("S")

// ---------------- exits
if not na(HH)
    strategy.exit("XL", from_entry = "L", stop = HH)
    strategy.exit("XS", from_entry = "S", stop = LL)

if lastBar or (newDay and strategy.position_size != 0)
    strategy.close_all(comment = "22:00", immediately = true)

// ---------------- drawing
showLv = okDay and startMin >= 540 and startMin < 1320
plot(showLv ? HH : na, "Range high (long stop)", color = color.new(color.gray, 0), style = plot.style_linebr)
plot(showLv ? LL : na, "Range low (short stop)", color = color.new(color.gray, 0), style = plot.style_linebr)
plot(showLv ? upLvl : na, "Long trigger", color = color.new(color.teal, 0), style = plot.style_linebr, linewidth = 2)
plot(showLv ? dnLvl : na, "Short trigger", color = color.new(color.red, 0), style = plot.style_linebr, linewidth = 2)
bgcolor(inRng ? color.new(color.blue, 92) : inSig and okDay ? color.new(color.orange, 92) : na, title = "Range / signal window")

// ---------------- timeframe check: the rules need intraday bars of 60 minutes or less
if barstate.islast and (not timeframe.isintraday or tfMin > 60)
    label.new(bar_index, high, "UNGERDAX1 needs a 5m-60m chart (built for 5m)", style = label.style_label_down, color = color.red, textcolor = color.white)
