      + "20210930,20211007,20211014,20211021,20211028,20211104,20211110,20211118,20211124,20211202,20211209,20211216,20211223,20211230,20220106,20220113,20220120,20220127,20220203,20220210,20220217,20220224,20220303,20220310,20220317,20220324,20220331,20220407,20220414,20220421,20220428,20220505,20220512,20220519,20220526,20220602,20220609,20220616,20220623,20220630,20220707,20220714,20220721,20220728,20220804,20220811,20220818,20220825,20220901,20220908,"
      + "20220915,20220922,20220929,20221006,20221013,20221020,20221027,20221103,20221110,20221117,20221123,20221201,20221208,20221215,20221222,20221229,20230105,20230112,20230119,20230126,20230202,20230209,20230216,20230223,20230302,20230309,20230316,20230323,20230330,20230406,20230413,20230420,20230427,20230504,20230511,20230518,20230525,20230601,20230608,20230615,20230622,20230629,20230706,20230713,20230720,20230727,20230803,20230810,20230817,20230824,"
      + "20230831,20230907,20230914,20230921,20230928,20231005,20231012,20231019,20231026,20231102,20231109,20231116,20231122,20231130,20231207,20231214,20231221,20231228,20240104,20240111,20240118,20240125,20240201,20240208,20240215,20240222,20240229,20240307,20240314,20240321,20240328,20240404,20240411,20240418,20240425,20240502,20240509,20240516,20240523,20240530,20240606,20240613,20240620,20240627,20240703,20240711,20240718,20240725,20240801,20240808,"
      + "20240815,20240822,20240829,20240905,20240912,20240919,20240926,20241003,20241010,20241017,20241024,20241031,20241107,20241114,20241121,20241127,20241205,20241212,20241219,20241226,20250102,20250108,20250116,20250123,20250130,20250206,20250213,20250220,20250227,20250306,20250313,20250320,20250327,20250403,20250410,20250417,20250424,20250501,20250508,20250515,20250522,20250529,20250605,20250612,20250618,20250626,20250703,20250710,20250717,20250724,"
      + "20250731,20250807,20250814,20250821,20250828,20250904,20250911,20250918,20250925,20251120,20251126,20251204,20251211,20251218,20251224,20251231,20260108,20260115,20260122,20260129,20260205,20260212,20260219,20260226,20260305,20260312,20260319,20260326,20260402,20260409,20260416,20260423,20260430,20260507,20260514,20260521,20260528,20260604,20260611,20260618,20260625,20260702,20260709,20260716,20260723,20260730,20260806,20260813,20260820,20260827,"
      + "20260903,20260910,20260912"

var map<string, bool> M_CPI = map.new<string, bool>()
var map<string, bool> M_NFP = map.new<string, bool>()
var map<string, bool> M_CLM = map.new<string, bool>()

// NOTE the size guard. `for i = 0 to array.size(a) - 1` on an EMPTY
// array is `for i = 0 to -1`, and Pine counts DOWN when `to` is below
// `from` -- so it would run with i = 0 on an empty array and throw.
if barstate.isfirst
    a = str.split(CPI_DATES, ",")
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            map.put(M_CPI, array.get(a, i), true)
    b = str.split(NFP_DATES, ",")
    if array.size(b) > 0
        for i = 0 to array.size(b) - 1
            map.put(M_NFP, array.get(b, i), true)
    c = str.split(CLM_DATES, ",")
    if array.size(c) > 0
        for i = 0 to array.size(c) - 1
            map.put(M_CLM, array.get(c, i), true)

// ------------------------------------------------------------- the clock
yy = year(time, TZ)
mo = month(time, TZ)
dd = dayofmonth(time, TZ)
key = str.tostring(yy) + (mo < 10 ? "0" : "") + str.tostring(mo)
    + (dd < 10 ? "0" : "") + str.tostring(dd)

hh = hour(time, TZ)
mm = minute(time, TZ)
isSlot = hh == 8 and mm == 30

// THE TIMEFRAME IS NOT A PARAMETER. On a 30-minute chart an 08:30 bar
// still exists, so the old version happily traded there -- with a signal
// bar twice as long, an entry 15 minutes later and a hold twice as long,
// none of which it mentioned. A rule that changes when you change the
// zoom is three rules sharing a name. Trading is refused off 15m; pick
// the variant above instead.
okTF = timeframe.period == "15"

// the previous bar must really be 08:30 before its open is used as the
// 30-minute signal's open -- a session gap would otherwise reach back
// into the previous day
prev830 = hour(time[1], TZ) == 8 and minute(time[1], TZ) == 30
isDecide = sig30 ? (hh == 8 and mm == 45 and prev830) : isSlot
sigOpen  = sig30 ? open[1] : open

hasCPI = map.contains(M_CPI, key)
hasNFP = map.contains(M_NFP, key)
hasCLM = map.contains(M_CLM, key)
// a day carrying two releases is ONE trade, not two -- the Python
// treats a date as one observation that belongs to several strata
tradeIt = (useCPI and hasCPI) or (useNFP and hasNFP) or (useCLM and hasCLM)
// label priority matches the Python breakdown order
lbl = hasNFP ? "NFP" : hasCPI ? "CPI" : hasCLM ? "CLAIMS" : ""

isSignal = okTF and isDecide and tradeIt and close != sigOpen

// ------------------------------------------------------------ the trades
var float entryPx = na
var int   dir     = 0
var int   closeAt = na
var string curLbl = ""
//: v1.3 -- every trade gets its OWN order id. Reusing "FADE" for all of
//: them let a close aimed at one lifecycle match another.
var string curId  = ""
var int    tradeNo = 0
//: v1.4 -- ALL PERSISTENT STATE IS DECLARED HERE, above every block that
//: touches it. v1.2 declared nEntries in the recording section and
//: incremented it in the entry block, which runs FIRST -- Pine refuses a
//: variable used before its declaration, and my static checks, which
//: grep for strings, could not see order. One block, declared once, up
//: front: the class of bug is gone rather than the instance.
var array<float> gAll = array.new<float>()
var array<float> gCPI = array.new<float>()
var array<float> gNFP = array.new<float>()
var array<float> gCLM = array.new<float>()
var int nSlotBars = 0
var int nSignals  = 0
//: v1.2 -- the script reports its OWN order count beside TradingView's.
//: The tester showed ~1.9 trades per signal and three guesses at why
//: were three guesses too many. If nEntries matches nSignals but
//: strategy.closedtrades is double, the doubling is in the order
//: handling, not the signal. If nEntries is double, it is the signal.
var int nEntries  = 0
var int firstYr   = na
var int lastYr    = na


if isSignal and strategy.position_size == 0 and na(closeAt)
    dir     := close > sigOpen ? -1 : 1       // FADE the signal bar
    closeAt := bar_index + holdBars
    curLbl  := lbl
    nEntries += 1
    tradeNo  += 1
    curId    := "F" + str.tostring(tradeNo)
    if dir == -1
        strategy.entry(curId, strategy.short)
    else
        strategy.entry(curId, strategy.long)

// the order placed on the decision bar fills at THIS bar's open
if not na(closeAt) and bar_index == closeAt - holdBars + 1 and na(entryPx)
    entryPx := open

if not na(closeAt) and bar_index == closeAt and strategy.position_size != 0
    strategy.close(curId)

// ------------------------------------------------- record, in basis points

if isSlot
    nSlotBars += 1
if isSignal
    nSignals += 1
    firstYr := na(firstYr) ? yy : firstYr
    lastYr  := yy

// the close placed on bar closeAt fills at THIS bar's open
if not na(closeAt) and bar_index == closeAt + 1 and not na(entryPx)
    g = dir * (open / entryPx - 1.0) * 10000.0
    array.push(gAll, g)
    if curLbl == "CPI"
        array.push(gCPI, g)
    if curLbl == "NFP"
        array.push(gNFP, g)
    if curLbl == "CLAIMS"
        array.push(gCLM, g)
    entryPx := na
    closeAt := na
    dir     := 0
    curLbl  := ""

// ------------------------------------------------------------- the visuals
inTrade = not na(closeAt) and bar_index >= closeAt - holdBars
barMove = math.abs(close / sigOpen - 1.0) * 10000.0
bgcolor(showMrk and isSignal ? color.new(color.orange, 70) : na)
bgcolor(showMrk and inTrade and not isSignal
     ? color.new(color.blue, 90) : na)

if showMrk and isSignal
    label.new(bar_index, high,
         text  = lbl + "  " + str.tostring(barMove, "#.0") + " bp"
               + (close > sigOpen ? "  fade SHORT" : "  fade LONG"),
         style = label.style_label_down,
         color = color.new(color.orange, 20),
         textcolor = color.white, size = size.tiny)

// --------------------------------------------------------- the cross-check
// Pine's format strings are not worth trusting for a leading sign, so the
// sign is built by hand. "+#.00" is the kind of thing that silently
// renders as something else on someone else's build.
fmt(float v) => (v >= 0 ? "+" : "") + str.tostring(v, "#.00")

var table t = table.new(position.top_right, 5, 8,
     border_width = 1, frame_width = 1)

// `t` is read from the global scope rather than passed in, and no
// stateful built-in is called, so this is safe to invoke conditionally.
statRow(int r, string nm, array<float> a, float cost, string py) =>
    n = array.size(a)
    m = n == 0 ? na : array.avg(a)
    table.cell(t, 0, r, nm, text_size = size.small)
    table.cell(t, 1, r, str.tostring(n), text_size = size.small)
    table.cell(t, 2, r, na(m) ? "--" : fmt(m), text_size = size.small,
         text_color = na(m) ? color.gray : m > 0 ? color.green : color.red)
    table.cell(t, 3, r, na(m) ? "--" : fmt(m - cost), text_size = size.small,
         text_color = na(m) ? color.gray
                            : (m - cost) > 0 ? color.green : color.red)
    table.cell(t, 4, r, py, text_size = size.small, text_color = color.gray)

if showTbl and barstate.islast
    table.cell(t, 0, 0, "release",  bgcolor = color.gray,
         text_color = color.white, text_size = size.small)
    table.cell(t, 1, 0, "n",        bgcolor = color.gray,
         text_color = color.white, text_size = size.small)
    table.cell(t, 2, 0, "gross bp", bgcolor = color.gray,
         text_color = color.white, text_size = size.small)
    table.cell(t, 3, 0, "net bp",   bgcolor = color.gray,
         text_color = color.white, text_size = size.small)
    table.cell(t, 4, 0, "py 03-26", bgcolor = color.gray,
         text_color = color.white, text_size = size.small)

    // the reference column is the PYTHON gross for the SELECTED variant
    // over 2003-2026, entry open to exit open. A TradingView plan that
    // serves only a year or two of 15m history will not reproduce it,
    // which is what the years row below is for -- and is the likeliest
    // reason two charts ever seem to disagree.
    statRow(1, "ALL",    gAll, costBp,
         vSel == VA ? "+3.93" : vSel == VC ? "+6.09"
       : vSel == VD ? "+5.58" : "+8.23")
    statRow(2, "CPI",    gCPI, costBp,
         vSel == VA ? "+3.79" : vSel == VC ? "+4.98"
       : vSel == VD ? "+4.94" : "+7.08")
    statRow(3, "NFP",    gNFP, costBp,
         vSel == VA ? "+4.09" : vSel == VC ? "+7.28"
       : vSel == VD ? "+6.22" : "+9.44")
    statRow(4, "CLAIMS", gCLM, costBp,
         vSel == VA ? "+1.39" : vSel == VC ? "+0.36"
       : vSel == VD ? "-0.90" : "+0.79")

    // the diagnostics that matter when the numbers look wrong
    table.cell(t, 0, 5, "08:30 bars", text_size = size.tiny)
    table.cell(t, 1, 5, str.tostring(nSlotBars), text_size = size.tiny)
    table.cell(t, 2, 5, "signals", text_size = size.tiny)
    table.cell(t, 3, 5, str.tostring(nSignals), text_size = size.tiny)
    table.cell(t, 4, 5, timeframe.period == "15" ? "15m OK" : "WRONG TF",
         text_size = size.tiny,
         text_color = timeframe.period == "15" ? color.gray : color.red)
    table.cell(t, 0, 7, "entries", text_size = size.tiny)
    table.cell(t, 1, 7, str.tostring(nEntries), text_size = size.tiny)
    table.cell(t, 2, 7, "TV closed", text_size = size.tiny)
    table.cell(t, 3, 7, str.tostring(strategy.closedtrades),
         text_size = size.tiny,
         text_color = strategy.closedtrades > nEntries ? color.red
                                                       : color.gray)
    table.cell(t, 4, 7, "open " + str.tostring(strategy.opentrades),
         text_size = size.tiny, text_color = color.gray)
    table.cell(t, 0, 6, "years", text_size = size.tiny)
    table.cell(t, 1, 6, na(firstYr) ? "--" : str.tostring(firstYr),
         text_size = size.tiny)
    table.cell(t, 2, 6, "to", text_size = size.tiny)
    table.cell(t, 3, 6, na(lastYr) ? "--" : str.tostring(lastYr),
         text_size = size.tiny)
    table.cell(t, 4, 6, "py: 2003-2026", text_size = size.tiny,
         text_color = color.gray)

// A chart on the wrong timeframe finds no 08:30 bar and reports a clean
// zero, which is the most dangerous output a backtest can produce.
if barstate.islast and not okTF
    label.new(bar_index, high,
         text = "NO TRADES TAKEN -- wrong timeframe (" + timeframe.period
         + ").\nThis rule is built from 15-minute bars. A 30m chart still"
         + "\nhas an 08:30 bar, so an earlier version traded there with a"
         + "\nlonger signal, a later entry and a longer hold, and said"
         + "\nnothing. Set the chart to 15m and pick the rule in Settings.",
         style = label.style_label_down, color = color.red,
         textcolor = color.white, size = size.normal)
