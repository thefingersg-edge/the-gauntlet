//@version=6
// =====================================================================
//  PRE-MARKET RELEASE FADE  --  SPX500USD, 15 minute
//  generated by make_pine.py v1.5 from events_v2.csv -- do not hand edit
//
//  I am not a financial adviser. This is a measurement, not a
//  recommendation to take a position.
//
//  THE RULE (STRATEGY_PREMARKET_FADE section 1)
//    on a scheduled 08:30 ET US release, take the 08:30-08:45 bar
//    FADE it   -- bar closed up -> short, closed down -> long
//    enter     -- at the open of the 08:45 bar
//    exit      -- at the open of the 09:45 bar.  60 minutes. No stop.
//
//  WHAT IT IS WORTH (measured in Python, 561 events, 23.4 years)
//    gross  +3.79 bp   t +2.88      <- real
//    cost   -1.77 bp                <- OANDA SPX500USD round trip
//    net    +2.02 bp   t +1.53      <- not distinguishable from zero
//    Sharpe +0.32 +/- 0.21          <- the reason this is not tradeable
//
//  THE TIMEFRAME IS NOT A PARAMETER -- v1.1 fixed a real bug here.
//  On a 30-minute chart an 08:30 bar still exists, so v1.0 traded there
//  and silently became a different rule: signal bar twice as long, entry
//  15 minutes later, hold twice as long. It looked BETTER, and the
//  reason is worth knowing:
//
//    variant                       gross    net     SD   Sharpe   bp/yr
//    A  15m signal, 1h hold        +3.93  +2.16   31.4    0.34     +52
//    C  30m signal, 1h hold        +6.09  +4.32   39.4    0.54    +104
//    D  15m signal, 2h hold        +5.58  +3.81   58.9    0.32     +91
//    B  30m signal, 2h hold        +8.23  +6.46   59.2    0.54    +156
//
//  The longer HOLD adds return and variance in equal measure and leaves
//  the Sharpe where it was. The longer SIGNAL BAR does not -- deciding
//  at 09:00 instead of 08:45 lifts 0.34 to 0.54. Cost is 1.77 bp per
//  trade whatever the hold, so a bigger gross for the same two
//  crossings is arithmetic, not a fitted parameter.
//
//  B has the best bp/yr and is NOT the pick: by era it runs +5.44 then
//  +10.97, while C runs +7.08 then +5.12. Steady beats big.
//
//  ALL FOUR ARE DISCOVERY. They were measured after the fact on the same
//  23 years, and none has been confirmed out of sample. Choose the rule
//  in Settings so the choice is deliberate; the chart stays on 15m.
//
//  DEFAULTS: CPI and payrolls ON, claims OFF. Claims grosses +1.39 bp on
//  variant A against a 1.77 bp round trip -- and gets WORSE on every
//  other variant, down to -0.90. Turning it on is how you watch a
//  strategy pay the spread for nothing.
//
//  READ THE TABLE, NOT THE EQUITY CURVE. The table recomputes gross bp
//  from TradingView's bars and prints the Python figure beside it. If
//  the two disagree, one implementation is wrong and the table says so
//  on screen -- the curve will not, because it compounds and flatters.
//
//  ONE KNOWN AND MEASURED DIFFERENCE. Python exits at the CLOSE of the
//  09:30 bar; Pine cannot place an order that fills at a bar's close
//  without also filling the ENTRY at the signal bar's close, which is
//  the one price the spec forbids. So this exits at the OPEN of the
//  09:45 bar -- the same clock instant, the next print. Measured across
//  560 events the difference is +0.12 bp on a +3.8 bp effect.
// =====================================================================
strategy("Pre-market Release Fade [SPX500USD 15m]", overlay = true,
     initial_capital       = 100000,
     default_qty_type      = strategy.percent_of_equity,
     default_qty_value     = 100,
     commission_type       = strategy.commission.percent,
     commission_value      = 0.00885,   // per side; x2 = 1.77 bp round trip
     slippage              = 0,
     process_orders_on_close = false,
     calc_on_every_tick    = false,
     max_labels_count      = 500,
     //: v1.3 -- 21 entries booked as 38 closed trades in one run. The
     //: default close rule is FIFO, under which strategy.close(id) is
     //: not guaranteed to close the entry it names. ANY makes a close
     //: by name close exactly that entry. pyramiding 0 forbids a second
     //: entry stacking onto an open one.
     close_entries_rule    = "ANY",
     pyramiding            = 0,
     //: v1.5 -- THE ACTUAL CAUSE of 21 entries booking as 38 trades.
     //: Sized at 100% of equity against TradingView's default 100%
     //: margin, any adverse move just after entry breaches margin and
     //: the tester liquidates a sliver ON THE ENTRY BAR, booked as its
     //: own closed trade. The List of Trades shows the fingerprint:
     //: sizes of 0.08 and 1.0 beside the real ~12, same-bar exits,
     //: always at an adverse price. v1.3's unique ids changed nothing
     //: because it was never about ids. Margin 0 switches the
     //: simulation off -- one signal, one trade.
     margin_long           = 0,
     margin_short          = 0)

TZ = "America/New_York"

// ---------------------------------------------------------------- inputs
grpV = "Variant -- WHICH RULE, not which chart"
VA = "A  15m signal, 1h hold  --  registered.  Sharpe 0.34"
VC = "C  30m signal, 1h hold  --  Sharpe 0.54, steady in both eras"
VD = "D  15m signal, 2h hold  --  Sharpe 0.32, the hold alone adds nothing"
VB = "B  30m signal, 2h hold  --  Sharpe 0.54, but +5.44 then +10.97 by era"
vSel = input.string(VA, "Rule", options = [VA, VC, VD, VB], group = grpV,
     tooltip = "Running this on a 30-minute CHART used to change three "
             + "things at once -- signal length, entry time and hold -- "
             + "without saying so. Now the rule is chosen here and the "
             + "chart must be 15m, because 15m is the atom the other "
             + "variants are built from.\n\n"
             + "A is the pre-registered rule. C and B both raise the "
             + "Sharpe to 0.54, and they do it through the 30-minute "
             + "SIGNAL BAR, not the longer hold -- D holds twice as long "
             + "and lands back at 0.32 because it adds return and "
             + "variance in equal measure.\n\n"
             + "All four are DISCOVERY, measured after the fact on the "
             + "same 23 years. None has been confirmed out of sample.")
sig30    = vSel == VC or vSel == VB
holdBars = (vSel == VD or vSel == VB) ? 8 : 4

grpR   = "Releases to trade"
useCPI = input.bool(true,  "CPI", group = grpR)
useNFP = input.bool(true,  "Payrolls", group = grpR)
useCLM = input.bool(false, "Initial claims -- LOSES money on every variant",
     group = grpR,
     tooltip = "Claims is the one release that gets WORSE as the signal "
             + "bar and hold lengthen: +1.39 on A, +0.79 on B, +0.36 on "
             + "C, -0.90 on D -- against a 1.77 bp round trip every "
             + "time. Big releases take a while to be absorbed; small "
             + "ones do not, and the extra time is just variance.")

grpS  = "Stats table"
costBp = input.float(1.77, "Round-trip cost in bp", minval = 0, step = 0.01,
     tooltip = "Used for the NET column only. The backtest's own cost is "
             + "set in Properties > Commission, and defaults to the same "
             + "number.", group = grpS)
showTbl = input.bool(true, "Show the cross-check table", group = grpS)
showMrk = input.bool(true, "Mark release bars and the holding window",
     group = grpS)

